<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Waybill Tracking | SF Canada Agent</title>

  <meta
    name="description"
    content="SF Canada Agent international shipment tracking portal."
  >

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<!-- ========================================
     HEADER
======================================== -->

<header class="site-header">

  <div class="header-inner">

    <a href="/" class="brand">

      <img
        src="/sf-logo.png"
        alt="SF"
        class="brand-logo"
      >

      <div class="brand-divider"></div>

      <div class="brand-agent">
        <strong>Canada Agent</strong>
        <span>Tracking Portal</span>
      </div>

    </a>


    <nav class="desktop-nav">

      <a href="/" class="active">
        Tracking
      </a>

      <a
        href="https://www.sf-international.com/us/en/support/querySupport/delivery"
        target="_blank"
        rel="noopener"
      >
        Service Coverage
      </a>

      <a
        href="https://www.sf-international.com/us/en/support/querySupport/price"
        target="_blank"
        rel="noopener"
      >
        Time & Cost
      </a>

      <a
        href="https://www.sf-international.com/us/en/support/querySupport/servicePoint"
        target="_blank"
        rel="noopener"
      >
        Service Points
      </a>

    </nav>


    <div class="header-right">

      <span class="language">
        Canada · EN
      </span>

      <a
        href="/admin"
        class="agent-login"
      >
        Agent Login
      </a>

    </div>

  </div>

</header>


<!-- ========================================
     HERO
======================================== -->

<section class="hero">

  <div class="hero-decoration"></div>

  <div class="hero-inner">

    <div class="breadcrumbs">
      Home
      <span>/</span>
      Support
      <span>/</span>
      Waybill Tracking
    </div>


    <div class="hero-title-row">

      <div class="hero-red-line"></div>

      <div>

        <h1>
          Waybill Tracking
        </h1>

        <p>
          Track the latest transportation status of your international shipment.
        </p>

      </div>

    </div>


    <!-- TRACKING SEARCH -->

    <div class="tracking-panel">

      <form
        method="GET"
        action="/"
        id="trackingForm"
        class="tracking-form"
      >

        <div class="tracking-input-section">

          <label for="awb">
            WAYBILL NUMBER
          </label>

          <div class="tracking-input-row">

            <input
              id="awb"
              name="awb"
              type="text"
              value="<%= query || '' %>"
              placeholder="Enter your tracking number"
              autocomplete="off"
              spellcheck="false"
            >

            <button
              id="clearButton"
              type="button"
              class="input-clear"
              aria-label="Clear"
            >
              ×
            </button>

          </div>

        </div>


        <button
          type="submit"
          class="track-button"
        >
          <span>Query</span>
          <span class="track-arrow">→</span>
        </button>

      </form>


      <div class="tracking-options">

        <label class="remember-label">

          <input
            type="checkbox"
            id="rememberTracking"
          >

          <span class="fake-checkbox"></span>

          <span>Remember me</span>

        </label>


        <span class="tracking-tip">
          Enter the complete waybill number provided for your shipment.
        </span>

      </div>

    </div>

  </div>

</section>


<!-- ========================================
     CONTENT
======================================== -->

<main class="main-content">


<!-- ========================================
     ERROR
======================================== -->

<% if (notFound) { %>

<section class="message-card error-card">

  <div class="message-icon">
    !
  </div>


  <div class="message-body">

    <h2>
      Tracking information not found
    </h2>

    <p>
      We couldn't locate shipment information for
      <strong><%= query %></strong>.
    </p>

    <p class="secondary-text">
      Please check that the waybill number is correct and try again.
      Recently created shipments may require some time before tracking
      updates become available.
    </p>

  </div>

</section>

<% } %>


<!-- ========================================
     SHIPMENT
======================================== -->

<% if (waybill) {

  const currentStatus =
    waybill.current_status || 'Information Received';

  const statusLower =
    currentStatus.toLowerCase();

  let statusClass = 'status-transit';

  if (statusLower.includes('delivered')) {
    statusClass = 'status-delivered';
  }

  if (
    statusLower.includes('exception') ||
    statusLower.includes('hold') ||
    statusLower.includes('failed')
  ) {
    statusClass = 'status-exception';
  }

%>


<section class="shipment-card">


  <!-- TOP -->

  <div class="shipment-header">

    <div>

      <span class="eyebrow">
        WAYBILL NUMBER
      </span>

      <div class="waybill-row">

        <strong class="waybill-number">
          <%= waybill.tracking_number %>
        </strong>

        <button
          type="button"
          class="copy-button"
          data-number="<%= waybill.tracking_number %>"
          onclick="copyWaybill(this)"
        >
          Copy
        </button>

      </div>

    </div>


    <div class="status-badge <%= statusClass %>">

      <span class="status-dot"></span>

      <span>
        <%= currentStatus %>
      </span>

    </div>

  </div>


  <!-- ROUTE -->

  <div class="route-section">

    <div class="route-place">

      <span class="route-label">
        FROM
      </span>

      <strong>
        <%= waybill.sender_location || waybill.sender_name || 'Origin' %>
      </strong>

    </div>


    <div class="route-graphic">

      <span class="route-point"></span>

      <span class="route-line"></span>

      <span class="plane-icon">
        ✈
      </span>

      <span class="route-line"></span>

      <span class="route-point"></span>

    </div>


    <div class="route-place route-destination">

      <span class="route-label">
        TO
      </span>

      <strong>
        <%= waybill.receiver_location || waybill.receiver_name || 'Destination' %>
      </strong>

    </div>

  </div>


  <!-- DETAILS -->

  <div class="shipment-details">

    <div class="detail-item">

      <span>
        Service
      </span>

      <strong>
        <%= waybill.service_type || 'International Express' %>
      </strong>

    </div>


    <div class="detail-item">

      <span>
        Pieces
      </span>

      <strong>
        <%= waybill.pieces || '—' %>
      </strong>

    </div>


    <div class="detail-item">

      <span>
        Weight
      </span>

      <strong>
        <%= waybill.weight_kg ? waybill.weight_kg + ' kg' : '—' %>
      </strong>

    </div>


    <div class="detail-item">

      <span>
        Estimated Delivery
      </span>

      <strong>

        <% if (waybill.estimated_delivery) { %>

          <%= new Date(
            waybill.estimated_delivery
          ).toLocaleDateString(
            'en-CA',
            {
              year: 'numeric',
              month: 'short',
              day: 'numeric'
            }
          ) %>

        <% } else { %>

          —

        <% } %>

      </strong>

    </div>

  </div>


  <!-- TIMELINE -->

  <div class="history-section">

    <div class="history-heading">

      <div>

        <h2>
          Shipment Progress
        </h2>

        <p>
          Latest tracking information is shown first.
        </p>

      </div>


      <% if (events && events.length > 0) { %>

      <span class="update-count">
        <%= events.length %>
        update<%= events.length === 1 ? '' : 's' %>
      </span>

      <% } %>

    </div>


    <% if (!events || events.length === 0) { %>

    <div class="empty-events">

      <div class="empty-dot"></div>

      <div>

        <strong>
          Shipment information received
        </strong>

        <p>
          Additional tracking updates will appear here as the shipment progresses.
        </p>

      </div>

    </div>

    <% } %>


    <div class="timeline">

      <% events.forEach(function(ev, index) { %>

      <div class="timeline-event <%= index === 0 ? 'latest-event' : '' %>">

        <div class="timeline-marker">

          <span class="timeline-dot"></span>

          <% if (index !== events.length - 1) { %>

          <span class="timeline-line"></span>

          <% } %>

        </div>


        <div class="event-content">

          <div class="event-heading">

            <strong>
              <%= ev.status %>
            </strong>


            <% if (index === 0) { %>

            <span class="latest-tag">
              Latest
            </span>

            <% } %>

          </div>


          <% if (ev.description) { %>

          <p class="event-description">
            <%= ev.description %>
          </p>

          <% } %>


          <div class="event-meta">

            <% if (ev.location) { %>

            <span class="event-location">
              <%= ev.location %>
            </span>

            <% } %>


            <span class="event-time">

              <%= new Date(
                ev.event_time
              ).toLocaleString(
                'en-CA',
                {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                  hour: '2-digit',
                  minute: '2-digit'
                }
              ) %>

            </span>

          </div>

        </div>

      </div>

      <% }); %>

    </div>

  </div>

</section>

<% } %>


<!-- ========================================
     QUERY DESCRIPTION
======================================== -->

<section class="information-section">

  <div class="section-title">

    <div class="section-red-line"></div>

    <div>

      <h2>
        Query Description
      </h2>

      <p>
        Information about using the shipment tracking service.
      </p>

    </div>

  </div>


  <div class="steps-grid">

    <div class="step-card">

      <span class="step-number">
        01
      </span>

      <div>

        <h3>
          Enter a waybill
        </h3>

        <p>
          Enter the complete shipment tracking number supplied when the
          waybill was created.
        </p>

      </div>

    </div>


    <div class="step-card">

      <span class="step-number">
        02
      </span>

      <div>

        <h3>
          View progress
        </h3>

        <p>
          Check pickup, transit, customs processing, destination handling
          and delivery updates.
        </p>

      </div>

    </div>


    <div class="step-card">

      <span class="step-number">
        03
      </span>

      <div>

        <h3>
          Recent shipments
        </h3>

        <p>
          Newly created waybills may not display detailed updates until
          shipment processing begins.
        </p>

      </div>

    </div>

  </div>

</section>


<!-- ========================================
     QUICK SERVICES
======================================== -->

<section class="services-section">

  <div class="section-title">

    <div class="section-red-line"></div>

    <div>

      <h2>
        Query Support
      </h2>

      <p>
        Additional shipping information and support resources.
      </p>

    </div>

  </div>


  <div class="service-grid">


    <a
      href="https://www.sf-international.com/us/en/support/querySupport/delivery"
      target="_blank"
      rel="noopener"
      class="service-card"
    >

      <div class="service-icon">
        ◎
      </div>

      <div class="service-content">

        <h3>
          Service Coverage
        </h3>

        <p>
          Check supported shipping regions and destinations.
        </p>

      </div>

      <span class="service-arrow">
        →
      </span>

    </a>


    <a
      href="https://www.sf-international.com/us/en/support/querySupport/price"
      target="_blank"
      rel="noopener"
      class="service-card"
    >

      <div class="service-icon">
        ◷
      </div>

      <div class="service-content">

        <h3>
          Time & Cost
        </h3>

        <p>
          Review international transit time and shipping cost information.
        </p>

      </div>

      <span class="service-arrow">
        →
      </span>

    </a>


    <a
      href="https://www.sf-international.com/us/en/support/querySupport/servicePoint"
      target="_blank"
      rel="noopener"
      class="service-card"
    >

      <div class="service-icon">
        ⌖
      </div>

      <div class="service-content">

        <h3>
          Service Points
        </h3>

        <p>
          Search available service locations and shipping points.
        </p>

      </div>

      <span class="service-arrow">
        →
      </span>

    </a>


    <a
      href="https://www.sf-international.com/us/en/support/querySupport/prohibitions"
      target="_blank"
      rel="noopener"
      class="service-card"
    >

      <div class="service-icon">
        !
      </div>

      <div class="service-content">

        <h3>
          Item Restriction
        </h3>

        <p>
          Review restricted and prohibited shipment requirements.
        </p>

      </div>

      <span class="service-arrow">
        →
      </span>

    </a>


    <a
      href="https://www.sf-international.com/us/en/support/querySupport/exchangeRate"
      target="_blank"
      rel="noopener"
      class="service-card"
    >

      <div class="service-icon">
        $
      </div>

      <div class="service-content">

        <h3>
          Exchange Rate
        </h3>

        <p>
          View relevant exchange-rate information.
        </p>

      </div>

      <span class="service-arrow">
        →
      </span>

    </a>


    <a
      href="https://www.sf-international.com/us/en/support/querySupport/holiday"
      target="_blank"
      rel="noopener"
      class="service-card"
    >

      <div class="service-icon">
        ◫
      </div>

      <div class="service-content">

        <h3>
          Holiday Schedule
        </h3>

        <p>
          Check service arrangements during holidays.
        </p>

      </div>

      <span class="service-arrow">
        →
      </span>

    </a>

  </div>

</section>


<!-- ========================================
     HELP
======================================== -->

<section class="help-card">

  <div class="help-content">

    <span>
      SHIPMENT SUPPORT
    </span>

    <h2>
      Need help with your shipment?
    </h2>

    <p>
      Contact the servicing Canadian agent if you need assistance
      with a waybill or tracking update.
    </p>

  </div>


  <a
    href="https://www.sf-international.com/us/en/"
    target="_blank"
    rel="noopener"
    class="official-button"
  >
    SF International
    <span>→</span>
  </a>

</section>


</main>


<!-- ========================================
     FOOTER
======================================== -->

<footer class="footer">

  <div class="footer-inner">

    <div class="footer-brand">

      <img
        src="/sf-logo.png"
        alt="SF"
      >

      <div>

        <strong>
          Canada Agent Tracking Portal
        </strong>

        <span>
          International Shipment Tracking
        </span>

      </div>

    </div>


    <div class="footer-right">

      <p>
        This portal is operated as a Canadian agent shipment tracking interface.
      </p>

      <p>
        Official corporate and international service information is available
        through the SF International website.
      </p>

    </div>

  </div>

</footer>


<script>

/* ========================================
   ELEMENTS
======================================== */

const trackingInput =
  document.getElementById('awb');

const clearButton =
  document.getElementById('clearButton');

const rememberCheckbox =
  document.getElementById('rememberTracking');

const trackingForm =
  document.getElementById('trackingForm');


/* ========================================
   RESTORE SAVED TRACKING
======================================== */

const rememberEnabled =
  localStorage.getItem('sfRememberEnabled');

const savedTracking =
  localStorage.getItem('sfSavedTracking');


if (rememberEnabled === 'true') {

  rememberCheckbox.checked = true;

  if (
    savedTracking &&
    !trackingInput.value
  ) {

    trackingInput.value =
      savedTracking;

  }

}


/* ========================================
   FORM SUBMIT
======================================== */

trackingForm.addEventListener(
  'submit',
  function(event) {

    const value =
      trackingInput.value.trim();

    if (!value) {

      event.preventDefault();

      trackingInput.focus();

      return;

    }


    trackingInput.value = value;


    if (rememberCheckbox.checked) {

      localStorage.setItem(
        'sfRememberEnabled',
        'true'
      );

      localStorage.setItem(
        'sfSavedTracking',
        value
      );

    } else {

      localStorage.removeItem(
        'sfRememberEnabled'
      );

      localStorage.removeItem(
        'sfSavedTracking'
      );

    }

  }
);


/* ========================================
   CLEAR
======================================== */

clearButton.addEventListener(
  'click',
  function() {

    trackingInput.value = '';

    trackingInput.focus();

  }
);


/* ========================================
   COPY WAYBILL
======================================== */

function copyWaybill(button) {

  const value =
    button.getAttribute('data-number');


  if (!navigator.clipboard) {

    return;

  }


  navigator.clipboard
    .writeText(value)
    .then(function() {

      const original =
        button.innerText;

      button.innerText =
        'Copied';


      setTimeout(
        function() {

          button.innerText =
            original;

        },
        1300
      );

    });

}

</script>

</body>
</html>
