# Postgres connection string. Render provides this automatically when you
# attach a Render Postgres database to this service (as an environment
# variable named DATABASE_URL). For local development, point this at your
# own local Postgres instance.
DATABASE_URL=postgres://user:password@localhost:5432/sf_tracking

# Admin login credentials for the /admin panel. Change these before deploying!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Long random string used to sign session cookies. Change this before deploying!
SESSION_SECRET=please-change-this-to-a-long-random-string

PORT=3000
