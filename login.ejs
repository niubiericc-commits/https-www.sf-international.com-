<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Agent Login | SF International</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="brand">
        <span class="brand-mark">SF</span>
        <span>SF International<small>Shipment Tracking</small></span>
      </a>
    </div>
  </header>

  <div class="login-wrap">
    <div class="card">
      <h2 style="margin-top:0;">Agent Login</h2>
      <p class="muted">Manage waybills and tracking updates.</p>

      <% if (error) { %>
        <div class="notice" style="margin-bottom: 16px;"><%= error %></div>
      <% } %>

      <form method="POST" action="/admin/login">
        <div class="field">
          <label>Username</label>
          <input type="text" name="username" required autofocus />
        </div>
        <div class="field">
          <label>Password</label>
          <input type="password" name="password" required />
        </div>
        <button class="btn" type="submit" style="width:100%;">Log In</button>
      </form>
    </div>
  </div>
</body>
</html>
