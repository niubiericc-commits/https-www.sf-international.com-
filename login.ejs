<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Shipment Tracking | SF Canada Agent</title>

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<header class="site-header">

  <div class="header-inner">

    <a href="/" class="brand-area">
      <div class="brand-logo">SF</div>

      <div class="brand-text">
        <strong>SF Canada Agent</strong>
        <span>International Shipment Tracking</span>
      </div>
    </a>

    <div class="header-right">
      <span class="region">Canada · English</span>
      <a href="/admin" class="agent-link">Agent Login</a>
    </div>

  </div>

</header>


<section class="tracking-hero">

  <div class="tracking-hero-inner">

    <div class="breadcrumb">
      Home / Support / Tracking
    </div>

    <h1>Waybill Tracking</h1>

    <p class="hero-description">
      Enter your shipment tracking number to view the latest transportation status.
    </p>


    <form method="GET" action="/" class="tracking-search">

      <div class="tracking-input-wrap">

        <label for="awb">Tracking Number</label>

        <input
          id="awb"
          name="awb"
          type="text"
          autocomplete="off"
          spellcheck="false"
          placeholder="Enter your tracking number"
          value="<%= query || '' %>"
        >

      </div>

      <button type="submit" class="tracking-button">
        Track
      </button>

    </form>


    <div class="search-help">
      Please enter the complete waybill number provided by your shipping agent.
    </div>

  </div>

</section>


<main class="page-content">


  <% if (notFound) { %>

    <section class="tracking-message error-message">

      <div class="message-icon">!</div>

      <div>
        <h3>Tracking information not found</h3>

        <p>
          We could not locate shipment information for
          <strong><%= query %></strong>.
        </p>

        <p>
          Please verify the tracking number or contact your shipping agent for assistance.
        </p>
      </div>

    </section>

  <% } %>



  <% if (waybill) {

    const status = waybill.current_status || 'In Transit';

    const statusLower = status.toLowerCase();

    let statusClass = 'status-transit';

    if (statusLower.includes('delivered')) {
      statusClass = 'status-delivered';
    }

    if (
      statusLower.includes('exception') ||
      statusLower.includes('hold')
    ) {
      statusClass = 'status-exception';
    }

  %>


  <section class="shipment-card">

    <div class="shipment-top">

      <div>

        <div class="small-label">
          WAYBILL NUMBER
        </div>

        <div class="tracking-number">
          <%= waybill.tracking_number %>
        </div>

      </div>


      <div class="current-status <%= statusClass %>">

        <span class="status-dot"></span>

        <%= status %>

      </div>

    </div>



    <div class="route-section">

      <div class="route-location">

        <span class="route-label">FROM</span>

        <strong>
          <%= waybill.sender_location || waybill.sender_name || 'Origin' %>
        </strong>

      </div>


      <div class="route-line">

        <div class="route-circle"></div>

        <div class="route-track"></div>

        <div class="route-plane">
          ➜
        </div>

        <div class="route-track"></div>

        <div class="route-circle"></div>

      </div>


      <div class="route-location route-destination">

        <span class="route-label">TO</span>

        <strong>
          <%= waybill.receiver_location || waybill.receiver_name || 'Destination' %>
        </strong>

      </div>

    </div>



    <div class="shipment-details">

      <div class="detail-box">

        <span>Service</span>

        <strong>
          <%= waybill.service_type || 'International Express' %>
        </strong>

      </div>


      <div class="detail-box">

        <span>Pieces</span>

        <strong>
          <%= waybill.pieces || '—' %>
        </strong>

      </div>


      <div class="detail-box">

        <span>Weight</span>

        <strong>
          <%= waybill.weight_kg ? waybill.weight_kg + ' kg' : '—' %>
        </strong>

      </div>


      <div class="detail-box">

        <span>Estimated Delivery</span>

        <strong>

          <% if (waybill.estimated_delivery) { %>

            <%= new Date(
              waybill.estimated_delivery
            ).toLocaleDateString(
              'en-CA',
              {
                year: 'numeric',
                month: 'short',
                day: 'numeric'
              }
            ) %>

          <% } else { %>

            —

          <% } %>

        </strong>

      </div>

    </div>



    <div class="history-section">

      <div class="history-header">

        <h2>Shipment Progress</h2>

        <span>
          Latest update first
        </span>

      </div>


      <% if (!events || events.length === 0) { %>

        <div class="empty-history">

          Shipment information has been created.
          Additional tracking updates will appear here.

        </div>

      <% } %>



      <div class="tracking-timeline">


        <% events.forEach(function(ev, index) { %>

          <div class="tracking-event <%= index === 0 ? 'latest-event' : '' %>">


            <div class="timeline-column">

              <div class="timeline-dot"></div>

              <% if (index !== events.length - 1) { %>

                <div class="timeline-line"></div>

              <% } %>

            </div>


            <div class="event-content">


              <div class="event-top">

                <div class="event-status">
                  <%= ev.status %>
                </div>


                <% if (index === 0) { %>

                  <span class="latest-label">
                    Latest
                  </span>

                <% } %>

              </div>



              <% if (ev.description) { %>

                <div class="event-description">
                  <%= ev.description %>
                </div>

              <% } %>


              <% if (ev.location) { %>

                <div class="event-location">
                  <%= ev.location %>
                </div>

              <% } %>


              <div class="event-time">

                <%= new Date(
                  ev.event_time
                ).toLocaleString(
                  'en-CA',
                  {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                  }
                ) %>

              </div>


            </div>

          </div>

        <% }); %>


      </div>

    </div>

  </section>


  <% } %>



  <% if (!waybill && !notFound) { %>

    <section class="query-info">

      <h2>Tracking Information</h2>

      <p>
        Shipment tracking becomes available after the waybill information
        has been entered into the agent tracking system.
      </p>

      <p>
        Tracking updates may include pickup, transit, customs clearance,
        destination processing and delivery information.
      </p>

    </section>

  <% } %>


</main>



<footer class="site-footer">

  <div class="footer-inner">

    <div>

      <strong>SF Canada Agent Tracking</strong>

      <p>
        Shipment information portal for customers served through our Canadian agent operations.
      </p>

    </div>


    <div class="footer-disclaimer">

      Tracking information displayed on this portal is provided through
      the servicing agent's shipment management system.

    </div>

  </div>

</footer>


</body>
</html>
