<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Agent Login</title>

  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      min-height: 100%;
    }

    body {
      min-height: 100vh;

      font-family:
        Arial,
        Helvetica,
        "Segoe UI",
        sans-serif;

      background: #f4f5f6;

      color: #222;
    }


    /* HEADER */

    .header {
      height: 72px;

      background: #eeeeef;

      border-top: 5px solid #d7d7d9;
      border-bottom: 1px solid #dddddf;
    }

    .header-inner {
      max-width: 1100px;
      height: 67px;

      margin: 0 auto;
      padding: 0 24px;

      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand {
      display: flex;
      align-items: center;

      gap: 15px;

      text-decoration: none;
    }

    .brand img {
      width: 88px;
      height: 46px;

      object-fit: contain;

      mix-blend-mode: multiply;
    }

    .divider {
      width: 1px;
      height: 30px;

      background: #ccc;
    }

    .brand-text {
      display: flex;
      flex-direction: column;
    }

    .brand-text strong {
      color: #333;

      font-size: 14px;
    }

    .brand-text span {
      margin-top: 2px;

      color: #888;

      font-size: 10px;
    }

    .back-link {
      color: #777;

      font-size: 12px;

      text-decoration: none;
    }

    .back-link:hover {
      color: #d90012;
    }


    /* LOGIN AREA */

    .login-wrapper {
      min-height: calc(100vh - 72px);

      padding: 65px 20px;

      display: flex;
      justify-content: center;
      align-items: flex-start;
    }

    .login-card {
      width: 100%;
      max-width: 430px;

      background: #fff;

      border: 1px solid #e2e2e2;

      box-shadow:
        0 8px 30px rgba(0, 0, 0, 0.06);
    }

    .login-top {
      padding: 30px 32px 24px;

      border-bottom: 1px solid #ededed;
    }

    .red-line {
      width: 34px;
      height: 3px;

      margin-bottom: 17px;

      background: #d90012;
    }

    .login-top h1 {
      margin: 0;

      color: #292929;

      font-size: 25px;
      font-weight: 500;
    }

    .login-top p {
      margin: 8px 0 0;

      color: #999;

      font-size: 12px;
      line-height: 1.6;
    }


    /* FORM */

    .login-form {
      padding: 27px 32px 32px;
    }

    .field {
      margin-bottom: 20px;
    }

    .field label {
      display: block;

      margin-bottom: 7px;

      color: #666;

      font-size: 10px;
      font-weight: 700;

      letter-spacing: 0.6px;
    }

    .field input {
      width: 100%;
      height: 48px;

      padding: 0 14px;

      border: 1px solid #d8d8d8;

      outline: none;

      background: #fff;

      color: #222;

      font-size: 14px;

      transition: border-color 0.2s ease;
    }

    .field input:focus {
      border-color: #d90012;
    }

    .error {
      margin-bottom: 20px;

      padding: 11px 13px;

      background: #fff0f1;

      border-left: 3px solid #d90012;

      color: #b5000f;

      font-size: 11px;
    }

    .login-button {
      width: 100%;
      height: 50px;

      border: 0;

      background: #d90012;

      color: #fff;

      font-size: 13px;
      font-weight: 600;

      cursor: pointer;

      transition: background 0.2s ease;
    }

    .login-button:hover {
      background: #b9000f;
    }

    .login-note {
      margin-top: 17px;

      color: #aaa;

      font-size: 9px;
      line-height: 1.6;

      text-align: center;
    }


    @media (max-width: 600px) {

      .header-inner {
        padding: 0 15px;
      }

      .brand img {
        width: 70px;
      }

      .brand-text {
        display: none;
      }

      .divider {
        display: none;
      }

      .login-wrapper {
        padding: 35px 12px;
      }

      .login-top,
      .login-form {
        padding-left: 22px;
        padding-right: 22px;
      }

    }
  </style>
</head>


<body>


<header class="header">

  <div class="header-inner">

    <a href="/" class="brand">

      <img
        src="/sf-logo.png.webp"
        alt="SF"
      >

      <div class="divider"></div>

      <div class="brand-text">

        <strong>
          Canada Agent
        </strong>

        <span>
          Administration
        </span>

      </div>

    </a>


    <a href="/" class="back-link">
      ← Back to Tracking
    </a>

  </div>

</header>



<main class="login-wrapper">


  <section class="login-card">


    <div class="login-top">

      <div class="red-line"></div>

      <h1>
        Agent Login
      </h1>

      <p>
        Sign in to manage waybills and shipment tracking updates.
      </p>

    </div>



    <form
      method="POST"
      action="/admin/login"
      class="login-form"
    >


      <% if (error) { %>

        <div class="error">
          <%= error %>
        </div>

      <% } %>



      <div class="field">

        <label for="username">
          USERNAME
        </label>

        <input
          id="username"
          name="username"
          type="text"
          autocomplete="username"
          required
        >

      </div>



      <div class="field">

        <label for="password">
          PASSWORD
        </label>

        <input
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
        >

      </div>



      <button
        type="submit"
        class="login-button"
      >
        Log In
      </button>


      <div class="login-note">
        Authorized agent access only.
      </div>


    </form>


  </section>


</main>


</body>
</html>
